# TA2API Docker 部署环境变量样例
# 用法：cp docker/.env.example .env，然后编辑 .env（.env 不进 git）
#
# ---- 必填 ----

# PC 导出的凭据数据根目录（含 current-owner.json / Local State / users/ / app-auth/ 等）
# 在 fnOS 上通常是共享文件夹路径，例如 /vol1/1000/docker/ta2api/data
TA_DATA_ROOT=./data

# PC 上 tools/export-credentials.mjs 导出的 32B 主密钥（crypt-key.b64 的内容，base64 一行）
TA_CRYPT_KEY=

# ---- 建议必填 ----

# 端点 Bearer 校验密钥。端口暴露在局域网/公网时务必设置（客户端请求带 Authorization: Bearer <值>）
TA_API_KEY=

# ---- 可选 ----

# 宿主机映射端口（默认 8787）
# TA_PORT=8787

# 凭据续期上游网关覆盖（默认走桌面端实际值 agent-pre.teleai.com.cn，一般不用动）
# TA_REFRESH_BASE_URL=

# 积分接口调试开关（一般不用动）
# TA_POINTS_CHANNEL_ID=
# TA_POINTS_RUNTIME_ENV=
# TA_OS_TYPE=windows
