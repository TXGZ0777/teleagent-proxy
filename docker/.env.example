# TA2API Docker 部署环境变量样例
# 用法：cp docker/.env.example .env，然后编辑 .env（.env 不进 git）
#
# ---- 必填 ----

# PC 导出的凭据数据根目录（含 current-owner.json / Local State / users/ / app-auth/ 等）
# 在 fnOS 上通常是共享文件夹路径，例如 /vol1/1000/docker/ta2api/data
TA_DATA_ROOT=./data

# PC 上 tools/export-credentials.mjs 导出的 32B 主密钥（crypt-key.b64 的内容，base64 一行）
TA_CRYPT_KEY=

# ---- 建议必填 ----

# 端点 Bearer 校验密钥。端口暴露在局域网/公网时务必设置（客户端请求带 Authorization: Bearer <值>）
# 注：compose 已固定 TA_REQUIRE_AUTH=1（强制鉴权）——即使密钥表为空，未带有效密钥的调用也返回 401。
# 密钥在管理台（http://NAS_IP:8787/admin）生成，或直接用这把主密钥。
TA_API_KEY=

# 管理台令牌（建议必填）：局域网访问 http://NAS_IP:8787/admin 时必填——管理台能改密钥、
# 导入凭据，务必设一把长随机字符串。未设置时管理台自动退回仅容器内回环访问（局域网 403）。
TA_ADMIN_TOKEN=

# ---- 可选 ----

# 本地构建载荷架构（一般留空：自动跟随构建机 CPU，x86_64→x64 / ARM64→arm64）。
# 仅当你的 docker compose build 用的是不注入 TARGETARCH 的旧构建器、
# 构建报「不支持的载荷架构」时才显式设为 x64 或 arm64。
# TA_PAYLOAD_ARCH=

# 宿主机映射端口（默认 8787）
# TA_PORT=8787

# 凭据续期上游网关覆盖（默认走桌面端实际值 agent-pre.teleai.com.cn，一般不用动）
# TA_REFRESH_BASE_URL=

# 自动首续（默认 1=开）：凭据导入后 renew 第一次检查会自动 force 续期一次，
# 立即从 PC 接管会话链，避免 >21 天空窗期被 PC 桌面端抢先轮换作废本凭据。
# 设 0 关闭＝被动备份模式（NAS 不主动轮换，PC 桌面端保持登录不受影响）。
# TA_RENEW_AUTO_HANDOVER=1

# 积分接口调试开关（一般不用动）
# TA_POINTS_CHANNEL_ID=
# TA_POINTS_RUNTIME_ENV=
# TA_OS_TYPE=windows
